#!/bin/bash
set -e

case "$1" in
    purge)
        # Note: User data in ~/.quantclaw is NOT removed automatically
        # Users should manually remove it if desired
        echo ""
        echo "QuantClaw has been removed."
        echo ""
        echo "Note: User configuration in ~/.quantclaw was NOT removed."
        echo "To completely remove all data, run:"
        echo "  rm -rf ~/.quantclaw"
        echo ""

        # Reload systemd
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
