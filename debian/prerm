#!/bin/bash
set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Stop the service if it's running (user may have installed it)
        if [ -d /run/systemd/system ]; then
            if systemctl is-active --quiet ravbot 2>/dev/null; then
                echo "Stopping ravbot service..."
                systemctl stop ravbot || true
            fi
            if systemctl is-enabled --quiet ravbot 2>/dev/null; then
                echo "Disabling ravbot service..."
                systemctl disable ravbot || true
            fi
        fi
        ;;

    failed-upgrade)
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
